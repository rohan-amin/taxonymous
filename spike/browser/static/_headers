# Cloudflare Pages headers. The page may only load and contact this site: nothing chosen
# here can be sent anywhere. 'wasm-unsafe-eval' lets WebAssembly (the engine) run;
# 'unsafe-eval' is what Pyodide's loader needs today.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; connect-src 'self'; img-src 'self' blob: data:; worker-src 'self' blob:; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
